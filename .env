# BCP Enrollment Platform - Frontend Environment Configuration

# API Configuration
# Backend API URL - Change based on environment (must be reachable from browser)
VITE_API_URL=http://localhost:8080

# Keycloak Configuration (for future direct auth flow)
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=master
VITE_KEYCLOAK_CLIENT_ID=Enrollement-Frontend

# Application Name
VITE_APP_NAME=BCP Enrollment Platform

# Environment
VITE_ENV=development

# Debug Mode (Set to 'true' for detailed console logs)
VITE_DEBUG=true

# Optional: Analytics (Add later if needed)
# VITE_GA_ID=
# VITE_SENTRY_DSN=
